{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "An existing Prometheus datasource that scrapes node_exporter",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "dpl-ons-pay-ops",
  "title": "Data Platform Lab - Pinned ONS Pay Health",
  "tags": ["data-platform-lab", "ons-pay", "data-quality"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "registry_commit",
        "label": "Registry commit (40 hex)",
        "type": "textbox",
        "query": "COMMIT_SHA40",
        "current": { "text": "COMMIT_SHA40", "value": "COMMIT_SHA40" },
        "hide": 0
      },
      {
        "name": "source_sha256",
        "label": "Source SHA-256 (64 hex)",
        "type": "textbox",
        "query": "SOURCE_SHA256",
        "current": { "text": "SOURCE_SHA256", "value": "SOURCE_SHA256" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Overall health",
      "description": "1 = all configured checks passed, 0 = at least one failed. Missing data is not healthy.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dpl_ons_pay_monitor_healthy{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "UNHEALTHY", "color": "red" },
                "1": { "text": "HEALTHY", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Seconds since last evaluation",
      "description": "Evaluated against the current Prometheus time, so a stopped monitor does not appear fresh.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "time() - dpl_ons_pay_monitor_checked_at_seconds{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 7200 }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed checks",
      "description": "A nonzero count always makes overall health unhealthy.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dpl_ons_pay_monitor_checks_failed{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Skipped checks",
      "description": "Unconfigured optional SLAs remain visible rather than being counted as passing.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dpl_ons_pay_monitor_checks_skipped{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upstream source age (UTC days)",
      "description": "Source retrieval age; this does not reset when a job reprocesses the same old pin.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dpl_ons_pay_source_age_days{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "d" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pinned refresh age (hours)",
      "description": "Only successful audited refreshes of this exact pin reset the age.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dpl_ons_pay_last_vintage_refresh_age_hours{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "h" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Missing or suppressed pay (%)",
      "description": "Share of source rows without numeric reported pay; no imputation is performed.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "dpl_ons_pay_missing_pay_percent{model_version=\"1\",registry_commit=\"$registry_commit\",source_sha256=\"$source_sha256\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 9 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    }
  ]
}
